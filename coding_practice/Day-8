Day 08 - Introduction to Docker and CI/CD Pipelines
# Ansible - Install Docker Compose
---
- name: Install Docker Compose
  hosts: all
  become: yes
  tasks:
    - name: Install dependencies
      yum:
        name: "python3-pip"
        state: present
    - name: Install docker-compose
      pip:
        name: docker-compose

# Terraform - EC2 with security group and EBS volume_size
resource "aws_security_group" "allow_ssh_http" {
  name            = "allow_ssh_https"
  description     = "Allow SSH and HTTP access"

  ingress {
    from_port = 22
    to_port   = 22
    protocol  = "tcp"
    cidr_blocks = [0.0.0.0/0"]
  }

  ingress {
    from_port    = 80
    to_port      = 80
    protocol     = "tcp"
    cidr_blocks  = ["0.0.0.0/0"]
  }
}
resource "aws_instance" "Tcs-EC2" {
  ami           = "ami-23HDJFfdehj68"
  instance_type = "t3.micro"
  security_gropus = [aws_security_groups.allow_ssh_http.name]

  ebs_block_device {
    device_name  = "/dev/sdh"
    volume_size  = 20
  }
}


# Kubernetes - Service with NodePort
apiVersion: v1
kind: Service
metadata:
  name: tcs-service
spec:
  type: NodePort
  selector:
    app: tcs-service
  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
      nodePort: 30007

# Jenkinsfile - Docker Build and Push
pipeline {
    agent any
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build('tcs-app')
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://docker.io', 'docker-credentials') {
                        docker.image('tcs-app').push('latest')
                    }
                }
            }
        }
    }
}

#GitLab CI- Build & Push Docker Image
stages:
  - build
  - push

build:
  stage: build
  script:
    - docker build -t tcs-app .

push:
  stage: push
  script:
    - docker login -u "$CI_REGISTRY_USER" -p "$CI_REGISTRY_PASSWORD"
    - docker push tcs-app
