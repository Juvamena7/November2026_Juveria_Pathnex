  cidr_block = "10.0.0.0/16
}

resource "aws_instance" "Infosys-EC2" {
  ami             = "ami-23GDH766FFF"
  instance_type   = "c5.xlarge"
  subnet_id       = aws_vpc.main.id
  tags = {
    Name  = "InfosysEC2"
  }
}

# Kubernetes- Pod with Volume Mount

apiVersion: v1
kind: Pod
metadata:
  name: tcs-pod
spec:
  containers:
    - name: nginx
      image: nginx
      volumeMounts:
        - mountPath: /usr/share/nginx/html
          name: nginx-volume
  volumes:
    - name: nginx-volume
      hostPath: 
        path: /data
        type: Directory


# Shell Script - Check for running services
#!/bin/bash
service=("nginx" "docker" "httpd")
for service in "${service[@]}"
do 
  if systemctl is-active --quiet $service; then
    echo "$service is running"
  else 
    echo "$service is not running"
  fi 
done
  

