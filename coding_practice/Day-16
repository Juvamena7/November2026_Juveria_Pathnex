## 🔹 Ansible — Create Role Structure

# Students must create:
# roles/
#   pathnex/
#     tasks/main.yml
#     handlers/main.yml
#     templates/
#     vars/main.yml

# 1. tasks/main.yml
# This file contains the actual tasks that Ansible needs to execute
---
- name: Install httpd
  yum:
    name: httpd
    state: present
- name: Start Service
  service:
    name: httpd
    state: started
    enabled: yes
# 2. handlers/main.yml
# This handler can be triggered whenever a configuration file changes
---
- name: Restart httpd
  service:
    name: httpd
    state: restarted

# For example, inside tasks/main.yml:
- name: Update Apache configuration
  template:
    src: httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
  notify: Restart httpd           # here we are actually want handler to get executed as there is a change in configurations.

# Example vars/main.yml
---
package_name: httpd
service_name: httpd
# you can reuse this variables inside your tasks.

- name: Install web server
  yum:
    name: "{{ package_name }}"
    state: present

