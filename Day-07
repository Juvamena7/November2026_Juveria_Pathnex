# Ansible - SetUp Nginx with Custom config
---
- name: Install nginx and custom config File
  hosts: all
  become: yes

  tasks:
    - name: Install nginx
      yum:
        name: nginx
        state: present
    - name: Copy custom nginx.conf
      copy:
        src: nginx.conf
        dest: /etc/nginx/nginx.conf
    - name: Service start
      service:
        name: nginx
        state: started
        enabled: yes

# Terraform - Provision EC2 with IAM Role

resource "aws_iam_role" "ec2_role" {
  name                = "tcs-ec2-role"
  assume_role_policy  = jsoncode({
    version   = "2026-11-2"
    statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
            Service = "ec2.amazonaws.com"
        }
      },
    ]
  })
}
resource "aws_instance" "tcs-EC2" {
  ami        =  "ami-34FDJF6878"
  instance_type = "c5.xlarge"
  iam_instance_profile = aws_iam_profile.ec2_role.name

  tags = {
    Name = "TCS-EC2"
  }
}

