# Ansible - Create Dcoker Containers for Multiple Applications
```yaml
- name: Setup Docker containers for Multiple Apps
  hosts: all
  become: yes

  tasks:
    - name: Pull web app image
      docker_image:
        name: tcs-web-app
        source: pull
    - name: Pull database app Image
      docker_image:
        name: tcs-db-image
        source: pull
    - name: Run web app container
      docker_container:
        name: tcs-app
        image: tcs-web-app
        state: started
        published_ports:
          - "8080:80"
    - name: Run database app container
      docker_container:
        name: tcs-database
        image: tcs-db-image
        state: started
        published_ports:
          - "3306:3306" 

# Terraform -VPC with Private and Public Subnets
