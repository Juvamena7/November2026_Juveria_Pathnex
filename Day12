## Ansible- Ensure File with Content

---
- name: Create config file with pathnex
  hosts: all
  become: yes

  tasks:
    - name: Write content to file
      copy:
        dest: /ect/pathnex.conf
        content:
          Welcome to Pathnex DevOps Training
          Today is Day 12

## Terraform - RDS Sketleton
resource "aws_db_instance" "PathnexRDS" {
  allocated_storage          = 20
  engine                     = "mysql"
  instance_class             = "db.t3.micro"
  name                       = "pathnexdb"
  username                   = "admin"
  password                   = "password123"
  skip_final_sanpshot        = true
}

## Kubernetes - rolling update strategy
apiVersion: apps/v1
kind: Deployment
metadata: 
  name: pathnex-rolling
spec:
  replicas: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 1
  selector:
    matchLabels:
      app: pathnex-roll
  template:
    metadata:
      labels:
        app: pathnex-roll
    spec:
      containers:
        - name: web-app
          image: nginx


## Shell Script - Backup Directory
#!/bin/bash
SOURCE="/var/log"
DEST="/backup/pathnex-$(date +%F).tar.gz"

tar -xzf $DEST $SOURCE
echo "Backup created at: $DEST"

# Multi Branch - Pipelines
You will learn how to **handle multiple branches in Jenkins Pipeline**.

pipeline {
    agent any 
    environment {
        INSTITUTE_NAME = "Pathnex"
    }
    Stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }
    }
}

